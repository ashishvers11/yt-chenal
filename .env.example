# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional server-side YouTube Data API v3 key for public channel & video lookups.
# When connected via Google OAuth, the user's OAuth access token is used directly with YouTube Data API v3 & YouTube Analytics API.
YOUTUBE_API_KEY=""
